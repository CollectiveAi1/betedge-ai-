# --- Required ---
# Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/betedge_ai
# Signs NextAuth sessions AND the mobile bearer tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret
# Public origin of the deployment. Used for metadata, sitemap and Stripe return URLs.
NEXTAUTH_URL=http://localhost:3000

# --- Sports data (optional: each falls back to bundled demo data when unset) ---
ODDS_API_KEY=your-odds-api-key
BALLDONTLIE_API_KEY=your-balldontlie-key
CFBD_API_KEY=your-cfbd-key

# --- AI analysis (the prop detail page returns a canned packet without this) ---
ABACUSAI_API_KEY=your-abacus-ai-key

# --- Google sign-in (optional; the provider is hidden if unset) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Stripe (billing returns 503 until these are set) ---
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Price ids from the Stripe dashboard. Checkout rejects a plan whose id is missing.
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_ANNUAL_PRICE_ID=price_...

# --- Optional: seed an ELITE admin account (`yarn prisma db seed`) ---
# Both must be set or the seed is skipped. Password must be 12+ characters.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
